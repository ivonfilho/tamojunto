/* Regras específicas para todos os elementos do modal de perfil com prioridade máxima */
app-profile-modal * {
  -webkit-font-smoothing: antialiased !important;
  -moz-osx-font-smoothing: grayscale !important;
  text-rendering: optimizeLegibility !important;
}

/* Regras específicas para todos os labels do modal de perfil com prioridade máxima */
app-profile-modal ion-label {
