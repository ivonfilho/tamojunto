  color: #666 !important;
  font-size: 1.2rem !important;
  -webkit-font-smoothing: antialiased !important;
  -moz-osx-font-smoothing: grayscale !important;
  text-rendering: optimizeLegibility !important;
}

/* Regras específicas para todos os inputs do modal de perfil com prioridade máxima */
app-profile-modal ion-input,
app-profile-modal ion-select,
app-profile-modal ion-textarea {
  font-weight: 400 !important;
  font-size: 1.3rem !important;
  --color: #555 !important;
  -webkit-font-smoothing: antialiased !important;
  -moz-osx-font-smoothing: grayscale !important;
  text-rendering: optimizeLegibility !important;
}

/* Regras específicas para mobile em todos os elementos do modal de perfil com prioridade máxima */
@media (max-width: 768px) {
  app-profile-modal * {
    -webkit-font-smoothing: antialiased !important;
    -moz-osx-font-smoothing: grayscale !important;
    text-rendering: optimizeLegibility !important;
  }

  app-profile-modal ion-label {
    font-weight: 500 !important;
    color: #666 !important;
    font-size: 1.4rem !important;
  }

  app-profile-modal ion-input,
  app-profile-modal ion-select,
  app-profile-modal ion-textarea {
    font-weight: 400 !important;
    font-size: 1.5rem !important;
  }
}

// Cores melhoradas para status dos cupons - aplicação global
ion-chip[color="success"] {
  --background: #059669 !important;
  --color: #ffffff !important;

  ion-label {
    color: #ffffff !important;
    font-weight: 700 !important;
  }
}

ion-chip[color="danger"] {
  --background: #dc2626 !important;
  --color: #ffffff !important;

  ion-label {
    color: #ffffff !important;
    font-weight: 700 !important;
  }
}

ion-chip[color="primary"] {
  --background: #2563eb !important;
  --color: #ffffff !important;

  ion-label {
    color: #ffffff !important;
    font-weight: 700 !important;
  }
}

// Estilos para popover e alert (dropdowns de seleção)
.popover-content,
.alert-wrapper {
  ion-list {
    ion-item {
      ion-label {
        color: white !important;
      }
    }

    .alert-radio-label,
    .alert-checkbox-label,
    .select-interface-option {
      color: white !important;
    }
  }
}

// Estilos específicos para o select do Ionic
ion-select-popover {
  ion-list {
    background: var(--ion-color-primary);

    ion-item {
      --background: var(--ion-color-primary);
      --color: white;

      ion-label,
      ion-radio-group ion-item ion-label {
        color: white !important;
      }
    }
  }
}

/* ==================================================
   DESIGN SYSTEM PREMIUM - V2
   ================================================== */
:root {
  --ion-font-family: "Ubuntu", sans-serif;
  --font-size-base: 16px;
  --font-size-h1: 2rem;
  --font-size-h2: 1.5rem;
  --font-size-p: 1rem;
  --form-bg: #f8fafc;
  --form-border-radius: 12px;
  --form-focus-ring: #5b21b6;
  --form-error: #dc2626;
  --form-success: #16a34a;
}

@media (max-width: 768px) {
  :root {
    --font-size-base: 14px;
    --font-size-h1: 1.5rem;
    --font-size-h2: 1.2rem;
    --font-size-p: 0.9rem;
  }
}

/*
  Envelopamento Seguro para Formulários:
  Apenas elementos dentro de .premium-form recebem essa formatação!
*/
.premium-form {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;

  h1,
  h2 {
    font-size: var(--font-size-h2);
    font-weight: 700;
    color: var(--ion-color-dark, #333);
    margin-bottom: 1rem;
    text-align: center;
  }

  p {
    font-size: var(--font-size-p);
    color: #64748b;
    text-align: center;
  }

  .input-group {
    display: flex;
    flex-direction: column;
    margin-bottom: 1rem;

    ion-label {
      font-size: 0.95rem;
      font-weight: 600 !important;
      color: #334155 !important;
      margin-bottom: 0.5rem;
      transform: none !important; /* Desabilita label flutuante zoado */
    }

    ion-input,
    ion-textarea,
    ion-select,
    ion-segment {
      --background: var(--form-bg);
      --border-radius: var(--form-border-radius);
      --padding-start: 1rem;
      --padding-end: 1rem;
      --highlight-color-focused: var(--form-focus-ring);
      --highlight-color-valid: var(--form-success);
      --highlight-color-invalid: var(--form-error);

      font-weight: 400;
      color: #0f172a;
      box-shadow: inset 0 2px 4px 0 rgb(0 0 0 / 0.05);
      min-height: 48px;
    }

    ion-segment {
      --background: #e2e8f0;
      border-radius: var(--form-border-radius);
      padding: 4px;

      ion-segment-button {
        --color: #475569;
        --color-checked: #ffffff;
        --indicator-color: var(--ion-color-primary);
        --border-radius: 8px;
        min-height: 40px;

        &::part(indicator-background) {
          border-radius: 8px;
        }

        ion-label {
          font-weight: 600 !important;
          margin-bottom: 0;
        }
      }
    }
  }

  .error-messages,
  .error-message {
    color: var(--form-error);
    font-size: 0.8rem;
    margin-top: 0.4rem;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  ion-button {
    --border-radius: var(--form-border-radius);
    --box-shadow: 0 4px 6px -1px rgb(91 33 182 / 0.4);
    height: 52px;
    margin-top: 1rem;
    font-weight: 700;
    letter-spacing: 0.5px;

    ion-label {
      color: white !important;
    }
  }

  .forgot-password-options {
    display: flex;
    justify-content: space-between;
    margin-top: 1rem;
    font-size: 0.85rem;

    a {
      color: var(--ion-color-primary);
      text-decoration: none;
      font-weight: 500;

      &:hover {
        text-decoration: underline;
      }
    }
  }
}
