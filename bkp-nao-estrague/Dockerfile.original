FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /app

# Copy csproj and restore dependencies
COPY TamoJunto.API/*.csproj ./TamoJunto.API/
COPY TamoJunto.Domain/*.csproj ./TamoJunto.Domain/
COPY TamoJunto.Infra/*.csproj ./TamoJunto.Infra/
RUN dotnet restore TamoJunto.API/TamoJunto.API.csproj

# Copy everything else and build
COPY . ./
RUN dotnet publish TamoJunto.API/TamoJunto.API.csproj -c Release -o out

# Build runtime image
FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS runtime
WORKDIR /app
COPY --from=build /app/out ./

# Expor apenas a porta 8080 para o Railway
EXPOSE 8080

# Configurar variáveis de ambiente para produção
ENV ASPNETCORE_URLS=http://0.0.0.0:8080
ENV ASPNETCORE_ENVIRONMENT=Production

ENTRYPOINT ["dotnet", "TamoJunto.API.dll"]