{
  "name": "tamo-junto",
  "version": "0.0.1",
  "author": "Ionic Framework",
  "homepage": "https://ionicframework.com/",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "build:docker": "ng build --configuration production --output-path=www",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "build:android": "npm run build && ./node_modules/.bin/cap sync android",
    "build:apk": "npm run build && ./node_modules/.bin/cap sync android && cd android && ./gradlew assembleRelease",
    "build:aab": "npm run build && ./node_modules/.bin/cap sync android && cd android && ./gradlew bundleRelease",
    "sync:android": "./node_modules/.bin/cap sync android",
    "open:android": "./node_modules/.bin/cap open android",
    "deploy:railway": "npm run build:prod && railway up",
    "deploy:docker": "docker build -t tamo-junto-frontend .",
    "serve:prod": "npx http-server www -p 8080 -c-1"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^17.0.2",
    "@angular/common": "^17.0.2",
    "@angular/compiler": "^17.0.2",
    "@angular/core": "^17.0.2",
    "@angular/forms": "^17.0.2",
    "@angular/platform-browser": "^17.0.2",
    "@angular/platform-browser-dynamic": "^17.0.2",
    "@angular/router": "^17.0.2",
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.4.3",
    "@capacitor/haptics": "^7.0.0",
    "@capacitor/ios": "^7.4.3",
    "@capacitor/keyboard": "^7.0.0",
    "@capacitor/share": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0",
    "@capacitor/toast": "^7.0.0",
    "@ionic/angular": "^8.0.0",
    "apexcharts": "^4.7.0",
    "chart.js": "^2.9.4",
    "ionicons": "^7.0.0",
    "jspdf": "^3.0.1",
    "jspdf-autotable": "^5.0.2",
    "jwt-decode": "^4.0.0",
    "ng-apexcharts": "^1.7.0",
    "ng2-charts": "^4.1.1",
    "ngx-cookie-service": "^17.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.0.0",
    "@angular-eslint/builder": "^17.0.0",
