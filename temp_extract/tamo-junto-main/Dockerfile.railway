# Use .NET 6.0 runtime for Railway compatibility
FROM mcr.microsoft.com/dotnet/aspnet:6.0 AS base
WORKDIR /app
EXPOSE 8080

FROM mcr.microsoft.com/dotnet/sdk:6.0 AS build
WORKDIR /src

# Copy project files
COPY TamoJunto.API/*.csproj ./TamoJunto.API/
COPY TamoJunto.Domain/*.csproj ./TamoJunto.Domain/
COPY TamoJunto.Infra/*.csproj ./TamoJunto.Infra/

# Restore dependencies
RUN dotnet restore TamoJunto.API/TamoJunto.API.csproj

# Copy source code
COPY . .

# Build the application
WORKDIR /src/TamoJunto.API
RUN dotnet build "TamoJunto.API.csproj" -c Release -o /app/build

FROM build AS publish
RUN dotnet publish "TamoJunto.API.csproj" -c Release -o /app/publish

FROM base AS final
WORKDIR /app
COPY --from=publish /app/publish .
ENTRYPOINT ["dotnet", "TamoJunto.API.dll"]










